BOT_TOKEN=
DADATA_API_KEY=
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
# REGION/CITY больше не запирают охоту — географию выбирают в боте.
REGION=Татарстан
CITY=Казань

# LLM для поиска собственника/УК по зданию (OpenAI-compatible).
# Вариант A — RouterAI:
# ROUTERAI_API_KEY=
# ROUTERAI_BASE_URL=https://routerai.ru/api/v1
# ROUTERAI_MODEL=openai/gpt-4o-mini
# Вариант B — напрямую OpenAI:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Поиск школ/сайтов/ВК идёт через RouterAI plugin web (тот же ROUTERAI_API_KEY).
# Serper — сильно повышает попадание в Google SERP (особенно ФИО → VK):
# SERPER_API_KEY=
# Опционально: user-токен VK с правом users.search (иначе публичный поиск VK закрыт логином):
# VK_USER_TOKEN=
