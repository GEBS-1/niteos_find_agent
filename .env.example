BOT_TOKEN=
DADATA_API_KEY=
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
# REGION/CITY больше не запирают охоту — географию выбирают в боте.
REGION=Татарстан
CITY=Казань

# === Стоимость охоты ===
# По умолчанию массовая охота работает БЕЗ платного LLM/web research.
# Даже если ниже случайно останется HUNT_LLM_*=1, cheap mode их заблокирует.
HUNT_CHEAP_MODE=1
# Для ручной/глубокой проверки: сначала HUNT_CHEAP_MODE=0,
# затем включить только нужный этап.
# RouterAI как доп.проверка карточки: HUNT_CHEAP_MODE=0 + HUNT_LLM_VERIFY=1
# (без HUNT_LLM_WEB — дешевле; web-plugin отдельно и дороже).
HUNT_LLM_OWNER=0
HUNT_LLM_WEB=0
HUNT_LLM_VERIFY=0
# Финальная LLM-проверка уже собранной карточки (без web). По умолчанию ВКЛ
# даже при HUNT_CHEAP_MODE=1 — один дешёвый JSON-вызов на карточку.
# Выключить: HUNT_LLM_CARD_AUDIT=0
HUNT_LLM_CARD_AUDIT=1
# Основной режим: ОДИН RouterAI web-запрос на охоту → сразу карточки.
# Выключить (старый пайплайн карт/DaData): HUNT_LLM_ONESHOT=0
HUNT_LLM_ONESHOT=1

# LLM для точечной глубокой проверки собственника/УК (OpenAI-compatible).
# Вариант A — RouterAI:
# ROUTERAI_API_KEY=
# ROUTERAI_BASE_URL=https://routerai.ru/api/v1
# ROUTERAI_MODEL=openai/gpt-4o-mini
# Вариант B — напрямую OpenAI:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# В cheap mode поиск идёт через DaData / бесплатный web / List-Org и правила.
# RouterAI web включается только при HUNT_CHEAP_MODE=0 + HUNT_LLM_WEB=1.
# Serper — опциональный поисковый источник (особенно ФИО → VK):
# SERPER_API_KEY=
# Опционально: user-токен VK с правом users.search (иначе публичный поиск VK закрыт логином):
# VK_USER_TOKEN=
